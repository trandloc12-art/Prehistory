# =============================================================================
# .gitattributes cho project Godot 4.x (prehistory / DinoExpedition)
# Mục tiêu: chuẩn hoá line-ending (tránh warning CRLF/LF) + đánh dấu đúng
# file nào là text, file nào là binary để Git không "toang" diff/merge.
# =============================================================================

# Mặc định: để Git tự nhận diện text và chuẩn hoá theo LF khi lưu vào repo
* text=auto eol=lf

# ---------------------------------------------------------------------------
# Source code / config — ép LF rõ ràng
# ---------------------------------------------------------------------------
*.gd            text eol=lf
*.gdshader      text eol=lf
*.cs            text eol=lf
*.json          text eol=lf
*.cfg           text eol=lf
*.import        text eol=lf
*.gitignore     text eol=lf
*.gitattributes text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# ---------------------------------------------------------------------------
# Godot resource/scene files — về bản chất là text (định dạng .tscn/.tres
# dạng text, không phải binary) nên vẫn chuẩn hoá LF để diff/merge sạch
# ---------------------------------------------------------------------------
*.tscn          text eol=lf
*.tres          text eol=lf
project.godot   text eol=lf

# ---------------------------------------------------------------------------
# Binary assets — đánh dấu binary để Git KHÔNG cố diff hay convert line-ending
# (làm hỏng file nếu bị convert nhầm)
# ---------------------------------------------------------------------------
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.bmp           binary
*.hdr           binary
*.tga           binary
*.exr           binary

*.wav           binary
*.mp3           binary
*.ogg           binary

*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary

*.glb           binary
*.gltf          binary
*.fbx           binary
*.obj           binary
*.blend         binary

*.zip           binary
*.7z            binary
*.rar           binary

*.exe           binary
*.dll           binary
*.so            binary
*.dylib         binary
*.pck           binary
*.apk           binary
*.aab           binary

# ---------------------------------------------------------------------------
# (Tuỳ chọn) Git LFS — bỏ comment nếu project có nhiều asset nặng
# (ảnh lớn, audio dài, model 3D...) và bạn đã cài Git LFS
# ---------------------------------------------------------------------------
# *.png  filter=lfs diff=lfs merge=lfs -text
# *.wav  filter=lfs diff=lfs merge=lfs -text
# *.glb  filter=lfs diff=lfs merge=lfs -text